# Telegram (@BotFather) — jangan commit .env
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# WhatsApp personal via WAHA (self-host di Mac) — docs/WHATSAPP.md
# Isi nomor Anda sendiri tanpa + (contoh: 6281234567890) — jangan commit .env
WHATSAPP_ALLOWED_NUMBER=
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_SESSION=default
WAHA_API_KEY=change-me-in-production

# API lokal (bot → Mac)
BERICHTSHEFT_API=http://127.0.0.1:8765

# Ops dashboard (/dashboard) — kosong = akses terbuka (localhost only)
# Produksi / tunnel / HP: WAJIB diisi. Bootstrap mengisi random jika kosong.
# Auth: ?token= | Authorization: Bearer | X-Dashboard-Token | cookie bh_dashboard_token
DASHBOARD_TOKEN=

# BLok: prefer Keychain di Mac. Cloud VM: opsional env (jangan commit nilai nyata)
# python3 -m berichtsheft credentials set --service blok
# BLOK_USERNAME=
# BLOK_PASSWORD=

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_POLISH_ENABLED=true
AI_VISION_ENABLED=true

# Cursor SDK (Pro) — https://cursor.com/dashboard → Integrations / API Keys
CURSOR_API_KEY=
CURSOR_AGENT_MODEL=composer-2.5
